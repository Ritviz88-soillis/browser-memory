# Copy to .env and fill in. NEVER commit .env.

# LLM — at least one key is required. All three have free tiers with no
# credit card. Without LLM_PROVIDER, the first one with a key is used, in
# this order: groq, huggingface, gemini.
# Note: Gemini's free tier can be as low as 20 requests a day for a model,
# and every question uses two requests.
# LLM_PROVIDER=huggingface
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
HUGGINGFACEHUB_API_TOKEN=
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional hosted embeddings (the default local bge-small needs no key)
JINA_API_KEY=

# Optional: where the memory database file lives.
# Default: %LOCALAPPDATA%\browser-memory\memory.db
# MEMORY_DB_PATH=
