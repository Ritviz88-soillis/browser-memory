# Copy to .env and fill in. NEVER commit .env.

# LLM — at least one is required. Groq is used when its key is set (faster);
# otherwise Gemini. Both have free tiers with no credit card.
GROQ_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional hosted embeddings (the default local bge-small needs no key)
JINA_API_KEY=

# Optional: where the memory database file lives.
# Default: %LOCALAPPDATA%\browser-memory\memory.db
# MEMORY_DB_PATH=
